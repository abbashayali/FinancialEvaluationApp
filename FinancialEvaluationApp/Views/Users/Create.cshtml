@model FinancialEvaluationApp.ViewModels.Users.UserCreateVm
@{
    ViewData["Title"] = "ایجاد کاربر";
}
@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<div class="users-page container mt-4" dir="rtl">
    <div class="card shadow-sm">
        <div class="card-header thead-primary"><h5 class="mb-0">ایجاد کاربر</h5></div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RoleId" class="form-label"></label>
                        <select asp-for="RoleId" class="form-select" asp-items="ViewBag.Roles">
                            <option value="">— انتخاب نقش —</option>
                        </select>
                        <span asp-validation-for="RoleId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TemporaryPassword" class="form-label"></label>
                        <input asp-for="TemporaryPassword" class="form-control" autocomplete="new-password" />
                        <span class="form-text">حداقل ۱۲ کاراکتر.</span>
                        <span asp-validation-for="TemporaryPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-check form-switch mt-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="col-md-6 form-check form-switch mt-4">
                        <input asp-for="MustChangePassword" class="form-check-input" />
                        <label asp-for="MustChangePassword" class="form-check-label"></label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light">انصراف</a>
                    <button type="submit" class="btn btn-primary">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
