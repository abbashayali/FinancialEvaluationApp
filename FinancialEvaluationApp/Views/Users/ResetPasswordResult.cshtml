@model FinancialEvaluationApp.ViewModels.Users.ResetPasswordResultVm
@{
    ViewData["Title"] = "گذرواژه موقت";
}
<div class="users-page container mt-4" dir="rtl">
    <div class="alert alert-warning">
        گذرواژهٔ موقت فقط یک‌بار نمایش داده می‌شود. آن را امن ذخیره/ارسال کنید.
    </div>

    <div class="card shadow-sm">
        <div class="card-header thead-primary"><strong>ریست گذرواژه</strong></div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">نام کاربری</dt>
                <dd class="col-sm-9">@Model.Username</dd>
                <dt class="col-sm-3">نام کامل</dt>
                <dd class="col-sm-9">@Model.FullName</dd>
                <dt class="col-sm-3">نقش</dt>
                <dd class="col-sm-9">@Model.RoleName</dd>
                <dt class="col-sm-3">گذرواژهٔ موقت</dt>
                <dd class="col-sm-9"><code>@Model.TemporaryPassword</code></dd>
            </dl>
            <p class="text-muted mb-0">کاربر باید در اولین ورود گذرواژه را تغییر دهد.</p>
        </div>
    </div>

    <div class="mt-3 text-end">
        <a asp-action="Index" class="btn btn-primary">بازگشت به لیست</a>
    </div>
</div>
