@using System.Linq
@using UserAdminKit.Abstractions
@model IEnumerable<UserListItemVm>


@{
    ViewData["Title"] = "مدیریت کاربران";
    var items = (Model ?? Enumerable.Empty<UserListItemVm>()).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<div class="users-page container mt-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">مدیریت کاربران</h2>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary" title="تعداد کاربران">@items.Count</span>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-controller="Users" asp-action="Create" class="btn btn-success">
                    <i class="bi bi-person-plus me-1"></i> کاربر جدید
                </a>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle users-table">
            @{
                var sort = (ViewBag.Sort as string ?? "username").ToLowerInvariant();
                var dir = (ViewBag.Dir as string ?? "asc").ToLowerInvariant();

                Func<string, string> nextDir = col => (sort == col && dir == "asc") ? "desc" : "asc";
                Func<string, string> caret = col =>
                {
                    if (sort != col) return "";
                    return dir == "asc"
                            ? "<i class=\"bi bi-caret-up-fill\"></i>"
                            : "<i class=\"bi bi-caret-down-fill\"></i>";
                };
            }

            <thead class="text-center thead-primary">
                <tr>
                    <th class="col-idx">
                        <span class="th-with-icon"><i class="bi bi-hash"></i> #</span>
                    </th>

                    <th class="col-username">
                        <a asp-action="Index" asp-route-sort="username" asp-route-dir="@(nextDir("username"))" class="th-link">
                            <span class="th-with-icon"><i class="bi bi-person-badge"></i> نام کاربری</span>
                            @Html.Raw(caret("username"))
                        </a>
                    </th>

                    <th class="col-fullname">
                        <a asp-action="Index" asp-route-sort="fullname" asp-route-dir="@(nextDir("fullname"))" class="th-link">
                            <span class="th-with-icon"><i class="bi bi-card-text"></i> نام کامل</span>
                            @Html.Raw(caret("fullname"))
                        </a>
                    </th>

                    <th class="col-role">
                        <a asp-action="Index" asp-route-sort="role" asp-route-dir="@(nextDir("role"))" class="th-link">
                            <span class="th-with-icon"><i class="bi bi-shield-check"></i> نقش</span>
                            @Html.Raw(caret("role"))
                        </a>
                    </th>

                    <th class="col-status">
                        <a asp-action="Index" asp-route-sort="status" asp-route-dir="@(nextDir("status"))" class="th-link">
                            <span class="th-with-icon"><i class="bi bi-toggle-on"></i> وضعیت</span>
                            @Html.Raw(caret("status"))
                        </a>
                    </th>

                    <th class="col-lastlogin">
                        <a asp-action="Index" asp-route-sort="lastlogin" asp-route-dir="@(nextDir("lastlogin"))" class="th-link">
                            <span class="th-with-icon"><i class="bi bi-clock-history"></i> آخرین ورود</span>
                            @Html.Raw(caret("lastlogin"))
                        </a>
                    </th>

                    <th class="col-actions">
                        <span class="th-with-icon"><i class="bi bi-wrench"></i> عملیات</span>
                    </th>
                </tr>
            </thead>

            <tbody class="text-center">
                @if (!items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-muted">هیچ کاربری یافت نشد.</td>
                    </tr>
                }
                else
                {
                    var i = 1;
                    foreach (var u in items)
                    {
                        var isAdminRow = string.Equals(u.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
                        var isAdmin = User.IsInRole("Admin");
                        var isManager = User.IsInRole("Manager");

                        // کاربر جاری
                        var selfId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        var isSelf = selfId != null &&
                        string.Equals(u.Id.ToString(), selfId, StringComparison.OrdinalIgnoreCase);

                        var canEdit = isAdmin || (isManager && !isAdminRow);
                        var canDelete = isAdmin && !isAdminRow; // منیجر حذف ندارد

                        // ریست: هیچ‌کس گذرواژه‌ی خودش را از اینجا ریست نکند
                        // ادمین برای بقیه، منیجر برای User/Manager (نه Admin)
                        var canReset =
                        !isSelf && (
                        isAdmin ||
                        (isManager && !isAdminRow)
                        );

                        <tr>
                            <td>@i</td>
                            <td class="col-username text-center">@u.Username</td>
                            <td class="col-fullname text-center">@u.FullName</td>
                            <td><span class="badge bg-info">@u.RoleName</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">غیرفعال</span>
                                }
                            </td>
                            <td>@u.LastLoginDisplay</td>


                            <td class="col-actions">
                                <div class="btn-actions">
                                    @if (canEdit)
                                    {
                                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@u.Id"
                                           class="btn btn-sm btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i><span class="ms-1">ویرایش</span>
                                        </a>
                                    }

                                    @if (canReset)
                                    {
                                        <form asp-controller="Users" asp-action="ResetPassword" asp-route-id="@u.Id"
                                              method="post" class="d-inline m-0 p-0"
                                              onsubmit="return confirm('گذرواژهٔ کاربر بازنشانی شود؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="ریست گذرواژه">
                                                <i class="bi bi-key"></i><span class="ms-1">ریست گذرواژه</span>
                                            </button>
                                        </form>
                                    }

                                    @if (canDelete)
                                    {
                                        <a asp-controller="Users" asp-action="Delete" asp-route-id="@u.Id"
                                           class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="bi bi-trash"></i><span class="ms-1">حذف</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>

                        i++;
                    }
                }
            </tbody>

        </table>
    </div>
</div>
