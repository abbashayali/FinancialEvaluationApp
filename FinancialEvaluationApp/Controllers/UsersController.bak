using FinancialEvaluationApp.Data;         // DbContext
using FinancialEvaluationApp.Models.Core;  // AppUser, AppRole
using FinancialEvaluationApp.ViewModels.Users;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Rendering;
using Microsoft.EntityFrameworkCore;
using UserAdminKit.Abstractions;
using System.Security.Claims;
using UVM = UserAdminKit.Abstractions;   // alias برای ویومدل‌های RCL
using Microsoft.AspNetCore.Mvc.Rendering; // برای SelectList



namespace FinancialEvaluationApp.Areas.UserAdmin.Controllers
{
    [Area("UserAdmin")]
    [Authorize(Roles = "Admin,Manager")]
    public class UsersController : Controller
    {
        private readonly FinancialEvaluationDbContext _db;

        public UsersController(FinancialEvaluationDbContext db)
        {
            _db = db;
        }

        // ===== Helpers =====
        private bool IsAdmin => User.IsInRole("Admin") || User.HasClaim("is_admin", "1");
        private bool IsManager => User.IsInRole("Manager") || User.HasClaim("is_manager", "1");
        private Guid? CurrentUserId
        {
            get
            {
                var id = User.FindFirstValue(ClaimTypes.NameIdentifier);
                return Guid.TryParse(id, out var g) ? g : (Guid?)null;
            }
        }

        private async Task<List<SelectListItem>> GetRoleItemsAsync(bool forManager)
        {
            // مدیر حق انتخاب Admin ندارد
            var q = _db.AppRoles.AsNoTracking();
            if (forManager)
                q = q.Where(r => r.Name != "Admin");

            return await q
                .OrderBy(r => r.Name)
                .Select(r => new SelectListItem { Value = r.Id.ToString(), Text = r.Name })
                .ToListAsync();
        }

        // قوانین حذف/ویرایش
        private static bool IsAdminRow(string? roleName) =>
            string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase);

        // ===== Index =====
        public async Task<IActionResult> Index(string? sort = "username", string? dir = "asc")
        {
            sort = (sort ?? "username").ToLowerInvariant();
            dir = (dir ?? "asc").ToLowerInvariant();
            bool asc = dir != "desc";

            var q = _db.AppUsers.AsNoTracking().Include(u => u.Role);

            // مدیرها نباید بتوانند ادمین را ببینند/دستکاری کنند؟ نمایش آزاد است ولی دستکاری محدود می‌شود.
            // اگر خواستی پنهانشان کنیم، این خط را آزاد کن:
            // if (IsManager) q = q.Where(u => u.Role.Name != "Admin");

            q = sort switch
            {
                "fullname" => asc ? q.OrderBy(u => u.FullName) : q.OrderByDescending(u => u.FullName),
                "role" => asc ? q.OrderBy(u => u.Role != null ? u.Role.Name : "")
                                   : q.OrderByDescending(u => u.Role != null ? u.Role.Name : ""),
                "status" => asc ? q.OrderBy(u => u.IsActive) : q.OrderByDescending(u => u.IsActive),
                "lastlogin" => asc ? q.OrderBy(u => u.LastLoginDate) : q.OrderByDescending(u => u.LastLoginDate),
                _ => asc ? q.OrderBy(u => u.Username) : q.OrderByDescending(u => u.Username),
            };

            var items = await q.Select(u => new UserListItemVm
            {
                Id = u.Id,
                Username = u.Username ?? "",
                FullName = u.FullName ?? "",
                RoleName = u.Role != null ? u.Role.Name : "—",
                IsActive = u.IsActive,
                LastLoginDisplay = u.LastLoginDate.HasValue
                    ? u.LastLoginDate.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    : null
            }).ToListAsync();

            ViewBag.Sort = sort;
            ViewBag.Dir = dir;
            return View(items);
        }

        // ===== Create =====
        public async Task<IActionResult> Create()
        {
            ViewBag.Roles = await GetRoleItemsAsync(forManager: IsManager && !IsAdmin);
            return View(new UserCreateVm());
        }

        [HttpPost, ValidateAntiForgeryToken]
        public async Task<IActionResult> Create(UserCreateVm vm)
        {
            ViewBag.Roles = await GetRoleItemsAsync(forManager: IsManager && !IsAdmin);
            if (!ModelState.IsValid) return View(vm);

            // مدیر حق ساختن Admin ندارد
            if (IsManager && !IsAdmin)
            {
                var roleName = await _db.AppRoles.Where(r => r.Id == vm.RoleId).Select(r => r.Name).FirstOrDefaultAsync();
                if (string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    ModelState.AddModelError(nameof(vm.RoleId), "Manager مجاز به ایجاد Admin نیست.");
                    return View(vm);
                }
            }

            var usernameKey = (vm.Username ?? "").Trim().ToLowerInvariant();
            var exists = await _db.AppUsers.AnyAsync(u => u.Username.ToLower() == usernameKey);
            if (exists)
            {
                ModelState.AddModelError(nameof(vm.Username), "این نام کاربری وجود دارد.");
                return View(vm);
            }

            var user = new AppUser
            {
                Id = Guid.NewGuid(),
                Username = (vm.Username ?? "").Trim(),
                FullName = (vm.FullName ?? "").Trim(),
                RoleId = vm.RoleId,
                IsActive = vm.IsActive,
                MustChangePassword = vm.MustChangePassword,
                PasswordHash = BCrypt.Net.BCrypt.HashPassword(vm.Password ?? vm.GenerateRandomPassword(), workFactor: 12),
                CreatedAt = DateTimeOffset.UtcNow
            };

            // فقط یک Admin
            if (await _db.AppRoles.AnyAsync(r => r.Id == vm.RoleId && r.Name == "Admin"))
            {
                var adminCount = await _db.AppUsers.CountAsync(u => u.Role!.Name == "Admin");
                if (adminCount >= 1)
                {
                    ModelState.AddModelError(nameof(vm.RoleId), "فقط یک کاربر Admin مجاز است.");
                    return View(vm);
                }
            }

            _db.AppUsers.Add(user);
            await _db.SaveChangesAsync();

            TempData["Success"] = "کاربر جدید ایجاد شد.";
            return RedirectToAction(nameof(Index));
        }

        // ===== Edit =====
        public async Task<IActionResult> Edit(Guid id)
        {
            var u = await _db.AppUsers.AsNoTracking().Include(x => x.Role).FirstOrDefaultAsync(x => x.Id == id);
            if (u == null) { TempData["Error"] = "کاربر پیدا نشد."; return RedirectToAction(nameof(Index)); }

            // Manager حق دستکاری Admin را ندارد
            if (IsManager && !IsAdmin && IsAdminRow(u.Role?.Name))
            {
                TempData["Warning"] = "Manager مجاز به ویرایش Admin نیست.";
                return RedirectToAction(nameof(Index));
            }

            var vm = new UserEditVm
            {
                Id = u.Id,
                Username = u.Username ?? "",
                FullName = u.FullName ?? "",
                RoleId = u.RoleId,
                IsActive = u.IsActive,
                MustChangePassword = u.MustChangePassword
            };

            ViewBag.Roles = await GetRoleItemsAsync(forManager: IsManager && !IsAdmin);
            return View(vm);
        }

        [HttpPost, ValidateAntiForgeryToken]
        public async Task<IActionResult> Edit(Guid id, UserEditVm vm)
        {
            ViewBag.Roles = await GetRoleItemsAsync(forManager: IsManager && !IsAdmin);
            if (id != vm.Id) return BadRequest();
            if (!ModelState.IsValid) return View(vm);

            var user = await _db.AppUsers.Include(x => x.Role).FirstOrDefaultAsync(x => x.Id == id);
            if (user == null) { TempData["Error"] = "کاربر پیدا نشد."; return RedirectToAction(nameof(Index)); }

            // Manager نمی‌تواند Admin را دستکاری کند
            if (IsManager && !IsAdmin && IsAdminRow(user.Role?.Name))
            {
                TempData["Warning"] = "Manager مجاز به ویرایش Admin نیست.";
                return RedirectToAction(nameof(Index));
            }

            // جلوگیری از تغییر نقش به Admin در حالتی که یک Admin داریم
            if (await _db.AppRoles.AnyAsync(r => r.Id == vm.RoleId && r.Name == "Admin"))
            {
                // اگر خود کاربر Admin نیست و قرار است Admin شود -> ممنوع، چون فقط یکی مجاز است
                if (!IsAdminRow(user.Role?.Name))
                {
                    var adminCount = await _db.AppUsers.CountAsync(u => u.Role!.Name == "Admin");
                    if (adminCount >= 1)
                    {
                        ModelState.AddModelError(nameof(vm.RoleId), "فقط یک کاربر Admin مجاز است.");
                        return View(vm);
                    }
                }
            }

            user.FullName = (vm.FullName ?? "").Trim();
            user.IsActive = vm.IsActive;
            user.MustChangePassword = vm.MustChangePassword;

            // نقش: Admin فقط می‌تواند نقش را تغییر دهد (Manager نمی‌تواند کسی را Admin کند)
            if (IsAdmin)
            {
                // جلوگیری از تبدیل کاربر دیگر به Admin دومی
                var targetRoleName = await _db.AppRoles.Where(r => r.Id == vm.RoleId).Select(r => r.Name).FirstOrDefaultAsync() ?? "";
                if (string.Equals(targetRoleName, "Admin", StringComparison.OrdinalIgnoreCase) && !IsAdminRow(user.Role?.Name))
                {
                    var adminCount = await _db.AppUsers.CountAsync(u => u.Role!.Name == "Admin");
                    if (adminCount >= 1)
                    {
                        ModelState.AddModelError(nameof(vm.RoleId), "فقط یک کاربر Admin مجاز است.");
                        return View(vm);
                    }
                }
                user.RoleId = vm.RoleId;
            }
            else if (IsManager)
            {
                // Manager می‌تواند فقط User/Manager بدهد
                var roleName = await _db.AppRoles.Where(r => r.Id == vm.RoleId).Select(r => r.Name).FirstOrDefaultAsync();
                if (string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    ModelState.AddModelError(nameof(vm.RoleId), "Manager مجاز به تخصیص Admin نیست.");
                    return View(vm);
                }
                user.RoleId = vm.RoleId;
            }

            user.UpdatedAt = DateTimeOffset.UtcNow;

            await _db.SaveChangesAsync();
            TempData["Success"] = "اطلاعات کاربر به‌روزرسانی شد.";
            return RedirectToAction(nameof(Index));
        }

        // ===== ResetPassword =====
        [HttpPost, ValidateAntiForgeryToken]
        public async Task<IActionResult> ResetPassword(Guid id)
        {
            var user = await _db.AppUsers.Include(u => u.Role).FirstOrDefaultAsync(u => u.Id == id);
            if (user == null) { TempData["Error"] = "کاربر پیدا نشد."; return RedirectToAction(nameof(Index)); }

            // برای خودش ریست نکند
            if (CurrentUserId.HasValue && user.Id == CurrentUserId.Value)
            {
                TempData["Warning"] = "ریست گذرواژهٔ حساب خودتان مجاز نیست. از تغییر گذرواژه استفاده کنید.";
                return RedirectToAction(nameof(Index));
            }

            // Manager نمی‌تواند Admin را ریست کند
            if (IsManager && !IsAdmin && IsAdminRow(user.Role?.Name))
            {
                TempData["Warning"] = "Manager مجاز به ریست گذرواژهٔ Admin نیست.";
                return RedirectToAction(nameof(Index));
            }

            var newPass = UserCreateVm.GenerateStrongPassword();
            user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(newPass, workFactor: 12);
            user.MustChangePassword = true;
            user.UpdatedAt = DateTimeOffset.UtcNow;

            await _db.SaveChangesAsync();
            TempData["Success"] = $"گذرواژهٔ جدید: {newPass}";
            return RedirectToAction(nameof(Index));
        }

        // ===== Delete =====
        [HttpPost, ValidateAntiForgeryToken]
        [Authorize(Roles = "Admin")] // حذف فقط برای ادمین
        public async Task<IActionResult> Delete(Guid id)
        {
            var user = await _db.AppUsers.Include(u => u.Role).FirstOrDefaultAsync(u => u.Id == id);
            if (user == null) { TempData["Error"] = "کاربر پیدا نشد."; return RedirectToAction(nameof(Index)); }

            // Admin حذف نشود
            if (IsAdminRow(user.Role?.Name))
            {
                TempData["Warning"] = "حذف Admin مجاز نیست.";
                return RedirectToAction(nameof(Index));
            }

            _db.AppUsers.Remove(user);
            await _db.SaveChangesAsync();

            TempData["Success"] = "کاربر حذف شد.";
            return RedirectToAction(nameof(Index));
        }
    }
}
