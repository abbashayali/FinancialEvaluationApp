	<ItemGroup>
		<ProjectReference Include="..\UserAdminKit.Abstractions\UserAdminKit.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
	</ItemGroup>
</Project>
